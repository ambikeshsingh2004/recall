# Copy to .env and fill in your keys. .env is git-ignored.

# --- LLM: primary provider (Groq, free tier) ---
# Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_SMALL_MODEL=openai/gpt-oss-20b
LLM_JSON_MODE=json_object
# gpt-oss is a reasoning model; "low" keeps it fast. Leave empty for non-reasoning models.
LLM_REASONING_EFFORT=low

# --- LLM: optional fallback, used when the primary is rate-limited or down ---
# Leave blank to disable. Examples:
#   Hugging Face:  LLM_FALLBACK_BASE_URL=https://router.huggingface.co/v1
#                  LLM_FALLBACK_API_KEY=hf_...
#                  LLM_FALLBACK_MODEL=meta-llama/Llama-3.1-8B-Instruct
#   Local Ollama:  LLM_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1
#                  LLM_FALLBACK_API_KEY=ollama
#                  LLM_FALLBACK_MODEL=recall-llm
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Cache LLM outputs in Postgres so repeated runs make no API calls.
LLM_CACHE=true

# --- LangSmith tracing (free Developer plan) ---
# Get a key at https://smith.langchain.com  -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_PROJECT=recall-dev
# Region: US = https://api.smith.langchain.com (default)
#         EU = https://eu.api.smith.langchain.com
#         APAC = https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# Database password. "recall" is fine locally; use a strong one on a server
# (set it before the first `docker compose up`, the DB keeps its first password).
POSTGRES_PASSWORD=recall

# Only used when running Python outside Docker; compose overrides it.
DATABASE_URL=postgresql://recall:recall@localhost:5433/recall
